# This file is an example only.
# Do not commit real secrets.
# Run it explicitly while dogfooding:
#   kitout status --config examples/kitout.private.yaml.example

version: 1

repos:
  - path: ~/code/private-project
    url: git@github.com:example/private-project.git
    branch: main

shell:
  - name: Check 1Password CLI login
    command: op account list
    when: always
